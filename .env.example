# Firebase, the same project the mobile app and the admin dashboard use.
# Copy this file to .env.local and fill it in, and set the same six variables in
# the Vercel project settings so the deployed site can reach Firebase too.
#
# These are client keys and are not secret: they identify the project rather
# than granting access. What a signed-in user may read or write is decided by
# the Firestore security rules, not by hiding these.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
